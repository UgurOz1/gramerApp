  "meaningDifference": [
    {
      "heading": "Karar ne zaman verildi?",
      "body": "Will’de karar konuşma anında doğar (The phone is ringing. I’ll answer it.). Be going to’da karar konuşmadan önce verilmiştir (I’m going to answer it after lunch.)."
    },
    {
      "heading": "Görüş mü, kanıt mı?",
      "body": "Will, kişisel görüşe dayanır (I think it will rain). Be going to, şu anda görülen bir kanıta dayanır (Look at those clouds! It’s going to rain.)."
    },
    {
      "heading": "Söz ve teklif",
      "body": "Söz verirken ve yardım teklif ederken will kullanılır: I’ll help you. I promise I’ll call. Bunlar için going to doğal değildir."
    },
    {
      "heading": "Plan ve niyet",
      "body": "Önceden düşünülmüş niyetler için be going to kullanılır: I’m going to learn French. Hazırlık yapılmışsa (I’ve bought a book) going to daha da doğal olur."
    },
    {
      "heading": "Soruların anlamı",
      "body": "Will you …? nazik bir ricadır (Will you open the door?). Are you going to …? ise niyet sorar (Are you going to open the door? = Kapıyı açmayı düşünüyor musun?)."
    }
  ],
  "decisionGuide": [
    {
      "question": "Karar tam şu anda mı verildi?",
      "answer": "Evet → will."
    },
    {
      "question": "Karar önceden verildi ve hazırlık yapıldı mı?",
      "answer": "Evet → be going to."
    },
    {
      "question": "Şu anda gözünle gördüğün bir kanıt var mı (bulut, kaza, hamilelik)?",
      "answer": "Evet → be going to."
    },
    {
      "question": "I think / I’m sure / probably ile görüş mü bildiriyorsun?",
      "answer": "Evet → will."
    },
    {
      "question": "Söz mü veriyorsun ya da yardım mı teklif ediyorsun?",
      "answer": "Evet → will."
    },
    {
      "question": "Kesinleşmiş bir randevu ve saat mi var?",
      "answer": "Evet → Present Continuous da kullanılabilir (I’m meeting Tom at six)."
    }
  ],
