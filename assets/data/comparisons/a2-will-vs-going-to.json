{
  "schemaVersion": 1,
  "id": "a2-will-vs-going-to",
  "levelId": "a2",
  "title": "Will vs Be Going To",
  "objectives": [
    "Anlık karar (will) ile önceden verilmiş karar (be going to) arasındaki farkı ayırt etmek",
    "Kişisel görüşe dayalı tahmin (will) ile kanıta dayalı tahmin (be going to) farkını anlamak",
    "Söz, teklif ve rica için will'i seçmek",
    "Plan ve niyet için be going to'yu seçmek"
  ],
  "intro": [
    "Türkçede ikisi de -ecek / -acak ile söylenir, bu yüzden İngilizcede hangisini seçeceğin kafa karıştırır. Karar zamanı ve elindeki kanıt farkı belirler.",
    "Kısaca: karar konuşma anında doğuyorsa will; karar önceden verilmişse ya da şu anda gözünün önünde bir kanıt varsa be going to.",
    "Bazı cümlelerde ikisi de doğru olabilir (örneğin genel tahminlerde); bu ders, bağlamın belirgin olduğu durumlarda doğru seçimi yapmanı sağlar."
  ],
  "lessonIds": [
    "a2-will",
    "a2-going-to"
  ],
  "structures": [
    {
      "name": "Will",
      "meaning": "Konuşma anında verilen karar, söz, teklif ve kişisel görüşe dayanan tahmin. Karar o anda doğar.",
      "usage": [
        "Anlık karar (The phone is ringing. I'll answer it.)",
        "Söz (I promise I'll call you.)",
        "Teklif ve rica (I'll carry your bag. Will you help me?)",
        "Görüşe dayalı tahmin (I think it will rain.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "Özne + will + yalın fiil",
          "example": "I'll help you."
        },
        {
          "label": "Olumsuz",
          "pattern": "Özne + won't + yalın fiil",
          "example": "I won't tell anyone."
        },
        {
          "label": "Soru",
          "pattern": "Will + özne + yalın fiil …?",
          "example": "Will you help me?"
        }
      ],
      "signals": [
        "I think",
        "I'm sure",
        "probably",
        "perhaps",
        "I promise",
        "I hope",
        "tomorrow",
        "in 2050"
      ]
    },
    {
      "name": "Be going to",
      "meaning": "Önceden verilmiş plan ve niyet; şu anda elimizde bir kanıt olan, olması neredeyse kesin gelecek olaylar.",
      "usage": [
        "Önceden verilmiş karar ve plan (I'm going to visit my aunt.)",
        "Şu anki kanıta dayalı tahmin (Look at the clouds! It's going to rain.)",
        "Hazırlığı yapılmış niyet (I've bought tickets. We're going to travel.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "Özne + am / is / are + going to + yalın fiil",
          "example": "I'm going to help."
        },
        {
          "label": "Olumsuz",
          "pattern": "Özne + am / is / are + not + going to + yalın fiil",
          "example": "I'm not going to tell."
        },
        {
          "label": "Soru",
          "pattern": "Am / Is / Are + özne + going to + yalın fiil …?",
          "example": "Are you going to help?"
        }
      ],
      "signals": [
        "Look!",
        "Be careful!",
        "I've decided",
        "I've already bought",
        "next week",
        "this weekend",
        "tonight"
      ]
    }
  ],
