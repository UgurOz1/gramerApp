  "meaningDifference": [
    {
      "heading": "Karar ne zaman verildi?",
      "body": "Karar konuşma anında doğuyorsa will (I’ll have the soup). Karar önceden verilmişse be going to (I’m going to order the soup)."
    },
    {
      "heading": "Kanıt var mı?",
      "body": "Şu anda gördüğün bir kanıt varsa be going to (It’s going to rain). Sadece görüşse will (I think it will rain)."
    },
    {
      "heading": "Düzenleme yapıldı mı?",
      "body": "Zaman, yer ve kişi belirliyse ve hazırlık yapıldıysa Present Continuous (I’m meeting Tom at six). Bu yapı be going to’dan daha kesindir."
    },
    {
      "heading": "Tarife ve program",
      "body": "Zaman çizelgeleri ve resmî programlar için Present Simple kullanılır (The train leaves at nine). Kişisel planlar için kullanılmaz."
    },
    {
      "heading": "Süreç ve tamamlanma",
      "body": "Gelecekteki bir anda süren eylem için Future Continuous (This time tomorrow I’ll be flying). Belirli bir zamana kadar tamamlanmış eylem için Future Perfect (By Friday I’ll have finished)."
    }
  ],
  "decisionGuide": [
    {
      "question": "Karar tam şu anda mı verildi?",
      "answer": "Evet → will."
    },
    {
      "question": "Söz veriyor ya da yardım mı teklif ediyorsun?",
      "answer": "Evet → will."
    },
    {
      "question": "Önceden verilmiş bir plan mı var?",
      "answer": "Evet → be going to."
    },
    {
      "question": "Şu anda gözünle gördüğün bir kanıt var mı?",
      "answer": "Evet → be going to."
    },
    {
      "question": "Randevu ya da bilet gibi kesinleşmiş bir düzenleme mi var?",
      "answer": "Evet → Present Continuous."
    },
    {
      "question": "Resmî tarife, program ya da takvim mi?",
      "answer": "Evet → Present Simple."
    },
    {
      "question": "Gelecekteki bir anda süren iş ya da o ana kadar biten iş mi?",
      "answer": "Evet → Future Continuous / Future Perfect."
    }
  ],
