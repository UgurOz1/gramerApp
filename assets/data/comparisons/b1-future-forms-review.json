{
  "schemaVersion": 1,
  "id": "b1-future-forms-review",
  "levelId": "b1",
  "title": "Future Forms Compared",
  "objectives": [
    "Will, be going to, Present Continuous ve Present Simple’ı gelecek anlamında ayırt etmek",
    "Anlık karar, plan, kesin düzenleme ve tarifeli olayları doğru yapıyla anlatmak",
    "Kanıta dayalı tahmin ile görüşe dayalı tahmini ayırt etmek",
    "Future Continuous ve Future Perfect’in anlamlarını bu dörtlüyle karşılaştırmak"
  ],
  "intro": [
    "İngilizcede gelecek tek bir yapıyla anlatılmaz. Her yapı, kararın ne zaman verildiğini, olayın ne kadar kesin olduğunu ve konuşanın bakış açısını yansıtır.",
    "Kısaca: anlık karar, söz ve görüş için will; önceden verilmiş plan ve kanıta dayalı tahmin için be going to; kesinleşmiş düzenlemeler için Present Continuous; tarifeler ve programlar için Present Simple kullanılır."
  ],
  "lessonIds": [
    "a2-will",
    "a2-going-to",
    "a2-present-continuous-future",
    "b1-future-continuous",
    "b1-future-perfect-intro"
  ],
  "structures": [
    {
      "name": "Will",
      "meaning": "Konuşma anında verilen karar, söz, teklif ve kişisel görüşe dayalı tahmin.",
      "usage": [
        "Anlık karar (I’ll have the soup.)",
        "Söz ve teklif (I’ll help you.)",
        "Görüş (I think it will rain.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + will + V1",
          "example": "I’ll call you later."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + won’t + V1",
          "example": "I won’t tell anyone."
        },
        {
          "label": "Soru",
          "pattern": "Will + özne + V1?",
          "example": "Will you help me?"
        }
      ],
      "signals": [
        "I think",
        "probably",
        "I promise",
        "I’m sure"
      ]
    },
    {
      "name": "Be going to",
      "meaning": "Önceden verilmiş plan ve niyet; şu anda elimizde kanıt olan tahmin.",
      "usage": [
        "Plan ve niyet (I’m going to learn French.)",
        "Kanıta dayalı tahmin (Look at the clouds! It’s going to rain.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + am / is / are + going to + V1",
          "example": "I’m going to visit Tom."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + am / is / are + not + going to + V1",
          "example": "She isn’t going to come."
        },
        {
          "label": "Soru",
          "pattern": "Am / Is / Are + özne + going to + V1?",
          "example": "Are you going to leave?"
        }
      ],
      "signals": [
        "Look!",
        "I’ve decided",
        "plan",
        "intend"
      ]
    },
    {
      "name": "Present Continuous",
      "meaning": "Kesinleşmiş düzenleme: zaman ve kişi belli, hazırlık yapılmış randevular.",
      "usage": [
        "Randevu ve rezervasyon (I’m meeting Tom at six.)",
        "Uçuş, bilet, toplantı düzenlemeleri (We’re flying to Rome on Friday.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + am / is / are + V-ing",
          "example": "I’m meeting him at six."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + am / is / are + not + V-ing",
          "example": "We aren’t leaving today."
        },
        {
          "label": "Soru",
          "pattern": "Am / Is / Are + özne + V-ing?",
          "example": "Are you coming tonight?"
        }
      ],
      "signals": [
        "tonight",
        "tomorrow",
        "next week",
        "at six o’clock"
      ]
    },
    {
      "name": "Present Simple",
      "meaning": "Tarifeler, programlar ve takvim olayları: otobüs, tren, film, ders saatleri.",
      "usage": [
        "Tarife (The train leaves at 9.)",
        "Program (The film starts at eight.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + V1 / V1-s",
          "example": "The bus leaves at nine."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + don’t / doesn’t + V1",
          "example": "The shop doesn’t open on Sundays."
        },
        {
          "label": "Soru",
          "pattern": "Do / Does + özne + V1?",
          "example": "What time does the film start?"
        }
      ],
      "signals": [
        "timetable",
        "schedule",
        "begins",
        "leaves"
      ]
    }
  ],
