{
  "schemaVersion": 1,
  "id": "b1-say-tell",
  "levelId": "b1",
  "title": "Say vs Tell",
  "objectives": [
    "Say ve tell’den sonra kişi nesnesinin gelip gelmediğini ayırt etmek",
    "Say to + kişi ve tell + kişi yapılarını doğru kurmak",
    "Tell ile kalıplaşmış ifadeleri (tell the truth, tell a lie, tell a story) kullanmak",
    "Say ile kalıplaşmış ifadeleri (say hello, say goodbye, say sorry) kullanmak"
  ],
  "intro": [
    "Say ve tell, Türkçede ikisi de “söylemek” diye karşılanır; ama İngilizcede kullanımları farklıdır. Asıl fark: tell’den sonra kime söylendiği (kişi) mutlaka gelir; say’den sonra söylenen söz gelir, kişi isteğe bağlıdır ve to ile eklenir.",
    "Ek olarak bazı kalıplar sabittir: tell the truth, tell a lie, tell a story, tell the time; say hello, say goodbye, say sorry, say a prayer."
  ],
  "lessonIds": [
    "a2-reported-speech-basic",
    "b1-reported-speech"
  ],
  "structures": [
    {
      "name": "Say",
      "meaning": "Söylenen sözü vurgular. Kişi gerekiyorsa say to + kişi ile eklenir. Doğrudan ve dolaylı anlatımda kullanılır.",
      "usage": [
        "Söz alıntılama (She said, “I’m tired.”)",
        "Dolaylı anlatım (She said she was tired.)",
        "Kalıplar (say hello, say sorry, say goodbye)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + said + (that) + cümle",
          "example": "He said that he was busy."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + didn’t say + (that) + cümle",
          "example": "She didn’t say anything."
        },
        {
          "label": "Soru",
          "pattern": "What did + özne + say?",
          "example": "What did he say?"
        }
      ],
      "signals": [
        "say that",
        "say to + kişi",
        "say hello",
        "say sorry"
      ]
    },
    {
      "name": "Tell",
      "meaning": "Kime söylendiğini vurgular. Tell’den sonra daima kişi gelir; ardından söylenen şey ya da to + fiil gelir.",
      "usage": [
        "Bilgi aktarma (She told me the news.)",
        "Emir aktarma (He told me to wait.)",
        "Kalıplar (tell the truth, tell a lie, tell a story, tell the time)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + told + kişi + (that) + cümle",
          "example": "He told me that he was busy."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + didn’t tell + kişi + şey",
          "example": "She didn’t tell me the secret."
        },
        {
          "label": "Soru",
          "pattern": "Did + özne + tell + kişi + şey?",
          "example": "Did he tell you the news?"
        }
      ],
      "signals": [
        "tell + kişi",
        "tell the truth",
        "tell a story",
        "tell someone to"
      ]
    }
  ],
