  "meaningDifference": [
    {
      "heading": "Kişi nesnesi",
      "body": "Tell’den sonra kime söylendiği daima gelir: He told me. Say’de kişi gerekiyorsa to ile eklenir: He said to me. Say me yanlıştır."
    },
    {
      "heading": "Söylenen şey",
      "body": "Say, sözün kendisine odaklanır (She said, “I’m tired.”). Tell, bilgiyi aktaran ve bilgiyi alan kişiyi öne çıkarır (She told me she was tired)."
    },
    {
      "heading": "Emir ve rica aktarma",
      "body": "Emir aktarırken tell + kişi + to + V1 kullanılır: He told me to wait. Say ile emir aktarmak için say to + kişi + (that) kalıbı genellikle tercih edilmez."
    },
    {
      "heading": "Sabit kalıplar (tell)",
      "body": "Tell the truth, tell a lie, tell a story, tell a joke, tell the time, tell the difference, tell the way gibi kalıplarda tell kullanılır."
    },
    {
      "heading": "Sabit kalıplar (say)",
      "body": "Say hello, say goodbye, say sorry, say thanks, say a prayer, say something, say a few words gibi kalıplarda say kullanılır."
    }
  ],
  "decisionGuide": [
    {
      "question": "Kime söylendiği cümlede var mı (me, him, us, Tom)?",
      "answer": "Evet → tell (told me)."
    },
    {
      "question": "Kişi yok, sadece söylenen söz mü var?",
      "answer": "Evet → say (She said she was tired)."
    },
    {
      "question": "Emir ya da rica mı aktarıyorsun?",
      "answer": "Evet → tell + kişi + to + V1."
    },
    {
      "question": "Kalıp: truth, lie, story, joke, time?",
      "answer": "Evet → tell."
    },
    {
      "question": "Kalıp: hello, goodbye, sorry, thanks?",
      "answer": "Evet → say."
    },
    {
      "question": "Say’den sonra kişi mi yazmak istiyorsun?",
      "answer": "Evet → say to + kişi (said to me)."
    }
  ],
  "confusions": [
    {
      "wrong": "He said me that he was tired.",
