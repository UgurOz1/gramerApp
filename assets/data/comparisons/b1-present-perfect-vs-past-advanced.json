{
  "schemaVersion": 1,
  "id": "b1-present-perfect-vs-past-advanced",
  "levelId": "b1",
  "title": "Present Perfect vs Past Simple: Advanced",
  "objectives": [
    "Yeni haberler ile geçmiş zaman ayrıntısı arasındaki farkı ayırt etmek",
    "Bitmemiş zaman ifadeleriyle (today, this week) Present Perfect kullanmak",
    "Bitmiş zaman ifadeleriyle (yesterday, last year, in 2010) Past Simple kullanmak",
    "Deneyim sorusundan (Have you ever…?) ayrıntı sorusuna (When did you…?) geçmek"
  ],
  "intro": [
    "A2’de Present Perfect ve Past Simple’ın temel farkını gördün. B1’de farkı bağlam üzerinden ayırt etmek gerekir: Present Perfect geçmişteki bir olayın şimdiyle bağını, Past Simple ise bitmiş ve zamanı belli geçmişi anlatır.",
    "Kısaca: zaman ifadesi bitmişse (yesterday, last week, in 2010, ago) Past Simple; zaman ifadesi bitmemişse (today, this week, so far, already, just) ya da zaman belirtilmemişse Present Perfect."
  ],
  "lessonIds": [
    "a2-present-perfect",
    "a2-past-simple"
  ],
  "structures": [
    {
      "name": "Present Perfect",
      "meaning": "Geçmişte başlayıp şimdiyle bağı olan olaylar: yeni haberler, deneyimler, sonuçları şimdi görülen olaylar ve bitmemiş zaman dilimleri.",
      "usage": [
        "Yeni haber (The president has resigned.)",
        "Deneyim (I have visited Rome twice.)",
        "Şimdiye etkisi olan olay (I have lost my keys.)",
        "Bitmemiş zaman (I have seen three films this week.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + have / has + V3",
          "example": "I have finished my work."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + haven’t / hasn’t + V3",
          "example": "She hasn’t called yet."
        },
        {
          "label": "Soru",
          "pattern": "Have / Has + özne + V3?",
          "example": "Have you ever been to Japan?"
        }
      ],
      "signals": [
        "just",
        "already",
        "yet",
        "ever / never",
        "so far",
        "this week / today",
        "for / since"
      ]
    },
    {
      "name": "Past Simple",
      "meaning": "Geçmişte bitmiş ve zamanı belli olan olaylar. Zaman ifadesi bitmiş bir zaman dilimini gösterir.",
      "usage": [
        "Zamanı belirtilmiş geçmiş olay (I saw him yesterday.)",
        "Ayrıntı sorusu (When did you arrive?)",
        "Geçmiş olay serisi (He got up, had breakfast and left.)",
        "Artık geçerli olmayan durum (She lived in Rome for ten years.)"
      ],
      "forms": [
        {
          "label": "Olumlu",
          "pattern": "özne + V2",
          "example": "I visited Rome in 2019."
        },
        {
          "label": "Olumsuz",
          "pattern": "özne + didn’t + V1",
          "example": "He didn’t come yesterday."
        },
        {
          "label": "Soru",
          "pattern": "Did + özne + V1?",
          "example": "Did you see the film last night?"
        }
      ],
      "signals": [
        "yesterday",
        "last week / year",
        "ago",
        "in 2010",
        "when",
        "this morning (bitti)"
      ]
    }
  ],
