  "meaningDifference": [
    {
      "heading": "Zaman ifadesi bitti mi?",
      "body": "Bitmiş zaman ifadeleriyle (yesterday, last week, in 2010, two days ago) Past Simple kullanılır. Bitmemiş ifadelerle (today, this week, this year) Present Perfect kullanılır."
    },
    {
      "heading": "Haber ve ayrıntı",
      "body": "Yeni haberi Present Perfect ile veririz (The president has resigned). Ayrıntıya geçince Past Simple’a döneriz (He resigned at 5 o’clock)."
    },
    {
      "heading": "Deneyim sorusu",
      "body": "Have you ever…? zamansız bir deneyimi sorar. Cevap alınca ayrıntı sorusu Past Simple ile sorulur: When did you go there?"
    },
    {
      "heading": "Süre: hâlâ mı sürüyor?",
      "body": "Hâlâ süren durumlarda Present Perfect + for / since: I have lived here for ten years. Bitmiş dönem için Past Simple: I lived there for ten years."
    },
    {
      "heading": "Şimdiye etki",
      "body": "Sonucu şu an görülen olaylar Present Perfect ile anlatılır (I’ve lost my keys, hâlâ bulamıyorum). Geçmiş olaylar zinciri Past Simple ile anlatılır."
    }
  ],
  "decisionGuide": [
    {
      "question": "Zaman ifadesi bitmiş mi (yesterday, ago, last year, in 2010)?",
      "answer": "Evet → Past Simple."
    },
    {
      "question": "Zaman ifadesi bitmemiş mi (today, this week, so far)?",
      "answer": "Evet → Present Perfect."
    },
    {
      "question": "When ile ayrıntı mı soruyorsun?",
      "answer": "Evet → Past Simple (When did you…?)."
    },
    {
      "question": "Yeni bir haber mi veriyorsun?",
      "answer": "Evet → Present Perfect, sonra ayrıntıda Past Simple."
    },
    {
      "question": "Durum hâlâ sürüyor mu (for / since)?",
      "answer": "Evet → Present Perfect."
    },
    {
      "question": "Zaman belirtmeden bir deneyimden mi söz ediyorsun?",
      "answer": "Evet → Present Perfect (ever, never)."
    }
  ],
  "confusions": [
